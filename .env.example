# ---------------------------------------------------------------------------
# Orbit enterprise web — local development environment.
#
# Copy to .env.local. Vite only exposes variables prefixed VITE_ to the client,
# which is the mechanism that stops a secret being bundled into JavaScript that
# every user downloads. Nothing secret belongs in this file regardless.
# ---------------------------------------------------------------------------

# The YARP gateway. Every request goes through it — there are no service URLs in
# this application, in any environment. The gateway is where authentication, rate
# limiting and header sanitisation happen.
VITE_GATEWAY_URL=http://localhost:8080

# What the browser calls. In development Vite proxies /api to the gateway above,
# which keeps the app same-origin and avoids CORS entirely.
VITE_API_BASE_URL=/api

PORT=5173
